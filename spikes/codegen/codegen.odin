// SPDX-License-Identifier: 0BSD
//
// Typed IR to Odin source (CLAUDE.md section 4.7). The output has to be
// readable: names come from the sketch, each statement carries a comment with
// its .roci line (the spike's stand-in for source mapping), and verbs are
// called by the same names the interpreter uses.
package codegen_spike

import "core:fmt"
import "core:strings"

generate :: proc(p: Program) -> string {
	b: strings.Builder
	strings.builder_init(&b)

	fmt.sbprintfln(&b, "// Generated by the rocinante code generator from %s.roci. Do not edit.", p.name)
	fmt.sbprintln(&b, "//")
	src := p.source
	for line in strings.split_lines_iterator(&src) {
		fmt.sbprintfln(&b, "//   %s", line)
	}
	fmt.sbprintln(&b, "package sketch")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "import \"verbs\"")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "main :: proc() {")

	// A name assigned anywhere in a sketch is sketch-wide (section 5.15), so
	// every assigned name is declared once at the top, starting at zero.
	names: [dynamic]string
	defer delete(names)
	collect_assigned(p.body, &names)
	for name in names {
		fmt.sbprintfln(&b, "\t%s: f64", name)
	}
	if len(names) > 0 {
		fmt.sbprintln(&b, "")
	}

	emit_body(&b, p.body, 1, fmt.tprintf("%s.roci", p.name))
	fmt.sbprintln(&b, "}")
	return strings.to_string(b)
}

collect_assigned :: proc(body: []Stmt, names: ^[dynamic]string) {
	for stmt in body {
		switch s in stmt {
		case Call:
		case Assign:
			seen := false
			for name in names {
				seen ||= name == s.name
			}
			if !seen {
				append(names, s.name)
			}
		case For:
			collect_assigned(s.body, names)
		}
	}
}

emit_body :: proc(b: ^strings.Builder, body: []Stmt, depth: int, file: string) {
	for stmt in body {
		indent(b, depth)
		switch s in stmt {
		case Call:
			fmt.sbprintf(b, "verbs.%s(", s.verb)
			for arg, i in s.args {
				if i > 0 {
					fmt.sbprint(b, ", ")
				}
				emit_expr(b, arg, true)
			}
			fmt.sbprintfln(b, ") // %s:%d", file, s.line)
		case Assign:
			fmt.sbprintf(b, "%s = ", s.name)
			emit_expr(b, s.value, true)
			fmt.sbprintfln(b, " // %s:%d", file, s.line)
		case For:
			fmt.sbprintf(b, "for %s := ", s.var)
			emit_expr(b, s.from, true)
			fmt.sbprintf(b, "; %s <= ", s.var)
			emit_expr(b, s.to, true)
			// The brace is a separate argument: a literal "{" in a format string
			// means something to Odin's fmt.
			fmt.sbprintfln(b, "; %s += 1 %s // %s:%d", s.var, "{", file, s.line)
			emit_body(b, s.body, depth + 1, file)
			indent(b, depth)
			fmt.sbprintln(b, "}")
		}
	}
}

indent :: proc(b: ^strings.Builder, depth: int) {
	for _ in 0 ..< depth {
		fmt.sbprint(b, "\t")
	}
}

emit_expr :: proc(b: ^strings.Builder, e: Expr, top: bool) {
	switch v in e {
	case Number:
		text := fmt.tprintf("%v", f64(v))
		fmt.sbprint(b, text)
		// An Odin literal without a dot would be an untyped integer.
		if !strings.contains_any(text, ".e") {
			fmt.sbprint(b, ".0")
		}
	case Var:
		fmt.sbprint(b, v.name)
	case Binary:
		if !top {
			fmt.sbprint(b, "(")
		}
		emit_expr(b, v.lhs^, false)
		fmt.sbprintf(b, " %s ", op_text(v.op))
		emit_expr(b, v.rhs^, false)
		if !top {
			fmt.sbprint(b, ")")
		}
	}
}

op_text :: proc(op: Op) -> string {
	switch op {
	case .Add: return "+"
	case .Sub: return "-"
	case .Mul: return "*"
	case .Div: return "/"
	}
	return "?"
}
