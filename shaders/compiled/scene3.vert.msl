vertex main0_out main0(main0_in in [[stage_in]], constant Scene& _106 [[buffer(0)]])
{
    main0_out out = {};
    float3 _387 = in.input_position + (in.input_normal * in.input_params.y);
    _387.y += (in.input_stretch * in.input_params.x);
    float4 _409 = float4(_387, 1.0);
