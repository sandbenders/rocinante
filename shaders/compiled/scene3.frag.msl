#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float3 input_world [[user(locn0)]];
    float3 input_normal [[user(locn1)]];
    float4 input_colour [[user(locn2)]];
    float3 input_eye [[user(locn3)]];
    float3 input_light [[user(locn4)]];
};

fragment main0_out main0(main0_in in [[stage_in]])
{
    main0_out out = {};
    float3 _108 = fast::normalize(in.input_normal);
    float3 _165;
    if (dot(_108, fast::normalize(in.input_eye - in.input_world)) < 0.0)
    {
        _165 = -_108;
    }
    else
    {
        _165 = _108;
    }
    out._entryPointOutput = float4(in.input_colour.xyz * (0.2800000011920928955078125 + (0.7200000286102294921875 * fast::clamp(dot(_165, fast::normalize(in.input_light)), 0.0, 1.0))), 1.0);
    return out;
}

