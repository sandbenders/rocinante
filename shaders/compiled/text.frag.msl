#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float2 input_uv [[user(locn0)]];
    float4 input_colour [[user(locn1), flat]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> font_texture [[texture(0)]], sampler font_textureSmplr [[sampler(0)]])
{
    main0_out out = {};
    float _89 = in.input_colour.w * font_texture.sample(font_textureSmplr, in.input_uv).x;
    out._entryPointOutput = float4(in.input_colour.xyz * _89, _89);
    return out;
}

