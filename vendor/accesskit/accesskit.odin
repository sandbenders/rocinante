#assert(offset_of(Rect, x0) == 0)
#assert(offset_of(Rect, y0) == 8)
#assert(offset_of(Rect, x1) == 16)
#assert(offset_of(Rect, y1) == 24)
#assert(size_of(Tree_Id) == 16)
#assert(offset_of(Tree_Id, bytes) == 0)
#assert(size_of(Point) == 16)
#assert(offset_of(Point, x) == 0)
#assert(offset_of(Point, y) == 8)
#assert(size_of(Text_Position) == 16)
#assert(offset_of(Text_Position, node) == 0)
#assert(offset_of(Text_Position, character_index) == 8)
#assert(size_of(Text_Selection) == 32)
#assert(offset_of(Text_Selection, anchor) == 0)
#assert(offset_of(Text_Selection, focus) == 16)
#assert(size_of(Action_Data) == 40)
#assert(offset_of(Action_Data, tag) == 0)
#assert(offset_of(Action_Data, u) == 8)
#assert(size_of(Opt_Action_Data) == 48)
#assert(offset_of(Opt_Action_Data, has_value) == 0)
#assert(offset_of(Opt_Action_Data, value) == 8)
#assert(size_of(Action_Request) == 80)
#assert(offset_of(Action_Request, action) == 0)
#assert(offset_of(Action_Request, target_tree) == 1)
#assert(offset_of(Action_Request, target_node) == 24)
#assert(offset_of(Action_Request, data) == 32)
