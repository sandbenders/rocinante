tcp listen "server" port 9400
tcp connect "chat" to "localhost" port 9400
on tcp open "chat" [ tcp send "chat" "hello" ]
heard = "waiting"

on tcp "server" [
  heard = received.text
  tcp send "server" ("you said " + received.text) to received.client
]

on tcp "chat" [ heard = received.text ]

draw [
  background 245
  fill 40
  text heard at 20 60 size 18
]
