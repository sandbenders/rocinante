# Blocks that run later may use names given further down the sketch.
draw [
  background 0
  fill tint
  circle pos size
  frames_seen = frames_seen + 1
]
on key "space" [ size = size + 10 ]
on mouse down [ pos = mouse ]
every 2 seconds [ tint = red ]
every 10 frames [ frames_seen = 0 ]

size = 20
pos = { 100, 100 }
tint = teal
frames_seen = 0

w = window 400 300
draw w [ circle 10 10 5 ]
on w receive message [ size = size + 1 ]
