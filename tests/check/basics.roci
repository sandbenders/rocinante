// Names, numbers, text, colours, vectors and calls: everything step 3a checks.
x = 10
name = "Ada"
SPEED = 4
ratio = 0.5
v = { 3, 4 }
u = v * 2 + { 1, 1 }
c = rgb 255 136 0
sky = gradient [ navy black ] angle 90
p = mouse
dx = p.x - width / 2
corner = u.xy
hit = dx > 3 and x is 10

window size 800 600 at 100 100
background [ navy black ] angle 90
fill c
alpha 200
circle at p radius 20
circle at x (x * 2) radius 50 fill [ red teal ]
rect at 0 0 size width height fill red
caps round
joins bevel
r = random from 1 to 3
n = noise x 0.5 as simplex
pick_one = pick [ red orange teal ]

if hit [ fill red ] else [ fill blue ]
repeat 10 [ circle at (random width) (random height) radius 5 ]
for i from 1 to 10 [ line from 0 (i * 10) to width (i * 10) ]
for each q in [ { 10, 20 } { 30, 40 } ] [ circle at q radius 10 ]
with fill cyan thickness 2 [
  circle at 100 100 radius 50
]
