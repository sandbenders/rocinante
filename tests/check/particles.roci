# The particle sketch: a list of records, added to, walked and changed.
particles = []
repeat 200 [ add { pos: { random width, 0 }, vel: { 0, random 3 }, life: 100 } to particles ]

draw [
  background 0
  for each p in particles [
    p.pos = p.pos + p.vel
    p.life = p.life - 1
    circle p.pos 3
  ]
]
