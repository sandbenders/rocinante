#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Fast local check before pushing. It runs the fast
# part of the build script's `ci` command once the build script exists.
root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1
if [ -d build ]; then
  exec odin run build -- ci --fast
fi
echo "pre-push: no build script yet, nothing to check"
