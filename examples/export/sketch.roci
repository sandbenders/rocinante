// Saving pictures: press s to save the window as output/shot.png, press v to save its shapes
// as a vector drawing, output/shot.svg, and press p to save them as a PDF page, output/shot.pdf.
// Press r to start or stop recording a frame sequence into output/frames, one numbered file
// for each frame; m to start or stop recording a video, output/movie.mp4, which ffmpeg makes
// (it has to be installed); and a to start or stop an animated PNG, output/movie.apng, which
// needs nothing else.
window size 480 320 title "export"
recording = false
filming = false
animating = false
saved = 0

on key "s" [
  save "shot.png"
  saved = saved + 1
]

on key "v" [ save "shot.svg" ]

on key "p" [ save "shot.pdf" ]

on key "r" [ recording = not recording ]

on key "m" [
  filming = not filming
  animating = false
  if filming [ record "movie.mp4" ] else [ no record ]
]

on key "a" [
  animating = not animating
  filming = false
  if animating [ record "movie.apng" ] else [ no record ]
]

draw [
  background (hsb 150 120 60)
  for i from 0 to 11 [
    spin = frame * 3 + i * 30
    fill (hsb (i * 20) 180 255)
    circle at (240 + (cos spin) * 110) (170 + (sin spin) * 110) radius 18
  ]
  if recording [ save "frames/frame-####.png" ]
  fill white
  font "Inter" size 15
  text "s png, v svg, p pdf, r frames, m mp4, a apng" at 20 20
  text ("saved " + saved + " pictures") at 20 44
  if recording or filming or animating [ text "recording" at 20 68 fill tomato ]
]
