// rocinante's logo, drawn with rocinante: a speech bubble with an asterisk in it.

window size 740 540 title "rocinante"
background white
grow 0.5
move -10 -90

MIDDLE = { 942, 622 }
RING = { 945, 630 }
TIP = { 90, 595 }
MOUTH_TOP = { 461, 595 }
MOUTH_BOTTOM = { 654, 1018 }
OUTLINE = 48

// The bubble
fill white
stroke black
thickness OUTLINE
circle at RING radius 485
quad TIP MOUTH_TOP RING MOUTH_BOTTOM
no stroke
circle at RING radius (485 - OUTLINE / 2)

// The dot, and the asterisk on it:
// one white bar, turned an eighth of a turn at a time.
circle at MIDDLE radius 365 fill black
push [
  move MIDDLE.x MIDDLE.y
  repeat 4 [
    rect at 0 0 size 80 460 as center
    turn 45
  ]
]
