# A night garden: two windows that talk, every kind of shape, gradients,
# transforms, noise and random, the mouse and the keyboard. Grass sways in a wind
# of noise, flowers turn, stars twinkle, a firefly follows the mouse, and a click
# plants a flower. The palette window recolours the garden and sets the wind
# through messages; both kinds are one record of fields the garden reads.
#
# Next to the Odin version this one has no text labels (text comes with the text
# verbs), no held-key or held-button state (so no dragging the wind bar and no
# calm-while-held), and no scale to fit the window.
GROUND = 470
SWATCH = 80

palettes = [
  {
    name: "dusk"
    sky: [ (rgb 20 24 70) (rgb 210 90 110) ]
    hill: [ (rgb 30 60 40) (rgb 60 90 60) ]
    grass: (rgb 120 190 110)
    petals: [ gold tomato ]
    moon: (rgb 255 240 200)
  }
  {
    name: "moon"
    sky: [ (rgb 5 8 25) (rgb 40 60 120) ]
    hill: [ (rgb 20 30 50) (rgb 40 55 80) ]
    grass: (rgb 90 140 160)
    petals: [ white lightskyblue ]
    moon: (rgb 220 230 255)
  }
  {
    name: "dawn"
    sky: [ (rgb 110 170 230) (rgb 255 210 160) ]
    hill: [ (rgb 70 130 60) (rgb 140 180 90) ]
    grass: (rgb 80 160 70)
    petals: [ hotpink purple ]
    moon: (rgb 255 250 230)
  }
]

chooser = window size 320 220 at 60 120 title "palette"
garden = window size 800 600 at 420 80 title "garden"

chosen = 1
wind = 0.5
calm = 1
flowers = []

learn plant place [
  add { at: place, size: random from 10 to 22, petals: 5 + random 4, spin: random from -40 to 40 } to flowers
]

seed 3
repeat 7 [ plant { random from 60 to 740, random from (GROUND + 30) to 570 } ]
first_planted = count flowers

# ---- the palette window ----

draw chooser [
  background 30
  for i from 1 to 3 [
    x = 16 + (i - 1) * (SWATCH + 20)
    p = item i of palettes
    if i is chosen [
      rect at x 44 size SWATCH SWATCH fill (gradient p.sky angle 90) stroke white thickness 3
    ] else [
      rect at x 44 size SWATCH SWATCH fill (gradient p.sky angle 90)
    ]
  ]
  rect at 16 170 size 288 10 fill [ (rgb 80 80 80) skyblue ]
  circle at (16 + wind * 288) 175 radius 9 fill (rgb 240 240 240)
]

on chooser mouse down [
  for i from 1 to 3 [
    x = 16 + (i - 1) * (SWATCH + 20)
    if mouse.x >= x and mouse.x < x + SWATCH and mouse.y >= 44 and mouse.y < 44 + SWATCH [
      send garden { palette: i }
    ]
  ]
  if mouse.y > 155 and mouse.y < 195 [
    send garden { wind: clamp (map mouse.x 16 304 0 1) 0 1 }
  ]
]

on chooser key "1" [ send garden { palette: 1 } ]
on chooser key "2" [ send garden { palette: 2 } ]
on chooser key "3" [ send garden { palette: 3 } ]

# ---- the garden ----

on garden receive message [
  if message.palette > 0 [ chosen = message.palette ]
  if message.wind > 0 [ wind = message.wind ]
]

on garden key "space" [ calm = 0.15 ]
on garden key "c" [ flowers = keep flowers [ it.size > 30 ] ]

learn draw_flower flower look [
  stroke (mix look.grass black 0.3)
  thickness 2
  line from flower.at to (flower.at + { 0, 40 })
  push [
    move flower.at
    turn (time * flower.spin)
    no stroke
    repeat flower.petals [
      turn (360 / flower.petals)
      ellipse at 0 (flower.size * -0.7) size (flower.size * 0.6) (flower.size * 1.3) fill (gradient look.petals angle 270)
    ]
    circle at 0 0 radius (flower.size * 0.3) fill gold stroke saddlebrown thickness 2
  ]
]

draw garden [
  p = item chosen of palettes
  background (gradient p.sky angle 90)

  seed 11
  no fill
  caps round
  for i from 1 to 70 [
    twinkle = noise (i * 3.1) (time * 2)
    stroke (rgb 255 255 255 alpha (120 + 135 * twinkle))
    thickness (1 + 2 * twinkle)
    point at (random 800) (random (GROUND - 60))
  ]

  no stroke
  circle at 660 110 radius 90 fill (gradient [ p.moon (rgb 255 255 255 alpha 0) p.moon ] as conic angle (time * 20)) alpha 70
  sky_top = item 1 of p.sky
  moon_edge = mix p.moon sky_top 0.4
  circle at 660 110 radius 46 fill (gradient [ p.moon moon_edge ] as radial)

  no fill
  caps butt
  thickness 7
  for i from 0 to 5 [
    ring = 360 - i * 7
    stroke (item (i + 1) of [ tomato orange gold mediumseagreen dodgerblue mediumpurple ])
    alpha 110
    arc at 260 (GROUND + 40) size (ring * 2) (ring * 2) from 180 to 360
  ]
  alpha 255

  no stroke
  far_hill = item 2 of p.hill
  fill (gradient [ far_hill (item 1 of p.hill) ] angle 90)
  quad { -2000, GROUND + 100 } { 2800, GROUND - 140 } { 2800, 3000 } { -2000, 3000 }

  near_hill = item 1 of p.hill
  caps round
  thickness 2
  for i from 0 to 199 [
    x = i * 4 + 2
    base = GROUND - x / 20 + 8
    tall = 18 + 22 * noise (i * 0.37)
    sway = (noise (i * 0.05) (time * 0.6) - 0.5) * 60 * wind * calm
    shade = (i % 5) / 8
    stroke (mix p.grass near_hill shade)
    line from x base to (x + sway) (base - tall)
  ]

  for each flower in flowers [ draw_flower flower p ]

  stroke (rgb 255 250 150 alpha 160)
  thickness 3
  line from pmouse to mouse
  no stroke
  circle at mouse radius 14 fill (gradient [ (rgb 255 250 150 alpha 200) (rgb 255 250 150 alpha 0) ] as radial)
  circle at mouse radius 3 fill (rgb 255 255 220)
]

on garden mouse down [
  if mouse.y > GROUND - 20 [ plant mouse ]
]
