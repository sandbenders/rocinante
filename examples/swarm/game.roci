// The game as a whole: starting over, one step of play, and drawing what is in play.

learn restart [
  score = 0
  lives = 3
  stage = 1
  shots = []
  bombs = []
  bits = []
  ships = []
  add (newship 1) to ships
  if players is 2 [
    add (newship 2) to ships
    lives = 5
  ]
  hatchall
]

// One frame of play: the ship, the swarm, every shot, the sparks, and a new stage when the
// swarm is gone.
learn advance [
  fly
  command
  shots_fly
  ship_hits
  if scene.name is "play" and (count swarm) is 0 and anyalive [
    stage = stage + 1
    hatchall
  ]
  fade
]

learn drawplay [
  for each e in swarm [ image (look e) at e.pos ]
  drawshots
  drawsparks
  drawships
]
