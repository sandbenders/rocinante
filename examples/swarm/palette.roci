  CLEAR
  white
  (rgb 235 50 60)
  (rgb 60 110 255)
  (rgb 255 220 40)
  (rgb 40 200 90)
  (rgb 170 70 230)
  (rgb 80 230 240)
  (rgb 255 150 30)
]
