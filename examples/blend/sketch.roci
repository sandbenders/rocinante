// Blend and clip. Each pair of circles is drawn with another blend, over the same gray:
// normal covers, add and screen glow, multiply goes dark, subtract takes color away and
// lighten keeps the brighter of the two. Below, a dim wall is drawn first and the
// same wall again, bright, inside a clip box that follows the mouse when you press it; the
// frame round it has rounded corners. A clip can be a shape too: the bright wall shows through the circle
// and the ellipse at the sides, each with a thick outline over its edge, so the picture does not depend on how a graphics card rounds the edge of a clip.
// A clip made inside another keeps only what is inside both, and `no clip` goes back to the one it was inside: the rounded
// square and the circle that sticks out of it show it, the circle bright only where it is inside the square.
window size 640 420 title "blend and clip"
spot = { 320, 310 }

learn pair x [
  fill orange
  circle at x 100 radius 30
  fill dodgerblue
  circle at (x + 34) 100 radius 30
]

learn wall bright [
  for i from 0 to 31 [
    rect at (i * 20) 200 size 14 200 fill (hsb (i * 8) 200 bright)
  ]
]

draw [
  background 110
  no stroke
  with blend normal [ pair 50 ]
  with blend add [ pair 140 ]
  with blend multiply [ pair 230 ]
  with blend screen [ pair 320 ]
  with blend subtract [ pair 410 ]
  with blend lighten [ pair 500 ]
  fill white
  font "Inter" size 12
  text "normal" at 36 150
  text "add" at 130 150
  text "multiply" at 208 150
  text "screen" at 304 150
  text "subtract" at 390 150
  text "lighten" at 482 150
  if pressed [ spot = mouse ]
  wall 110
  clip at (spot.x - 80) (spot.y - 60) size 160 120
  wall 255
  no clip
  clip circle at 70 340 radius 50
  wall 255
  no clip
  clip ellipse at 560 340 size 120 80
  wall 255
  no clip
  clip square at 150 300 size 80 round 20
  wall 40
  clip circle at 200 312 radius 36
  wall 255
  no clip
  no clip
  no fill
  stroke white
  thickness 4
  circle at 70 340 radius 50
  ellipse at 560 340 size 120 80
  square at 150 300 size 80 round 20
  circle at 200 312 radius 36
  thickness 1
  rect at (spot.x - 80) (spot.y - 60) size 160 120 round 16
]
