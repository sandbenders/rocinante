// Two windows that talk: a control window and a stage. Every frame the control
// window sends the mouse position, scaled to the stage, and a click sends a flash
// that makes the stage light up for a moment. The two kinds of message are records
// of different fields, so the stage reads one record that holds both.
control = window size 300 200 at 60 120 title "control"
stage = window size 520 420 at 400 80 title "stage"

heard = { 260, 210 }
flash_left = 0

draw control [
  background 40
  place = { mouse.x / width * 520, mouse.y / height * 420 }
  send stage { at: place }
  circle at mouse radius 6 fill orange
]

on control mouse down [ send stage { flash: 1 } ]

on stage receive message [
  if message.flash > 0 [ flash_left = 0.3 ] else [ heard = message.at ]
]

draw stage [
  if flash_left > 0 [
    flash_left = flash_left - 1 / 60
    background 245
  ] else [
    background 30
  ]
  fill tomato
  circle at heard radius 24
]
