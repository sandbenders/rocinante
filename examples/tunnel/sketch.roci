// A flight down a glowing tunnel. The sketch draws nothing itself: tunnel.hlsl makes the tunnel
// from nothing for every pixel, and lens.hlsl then gives the whole picture a camera's flaws.
// Move the mouse to look around; the numbers after by are the shaders' own values, so try
// changing glow or strength and saving a shader while it runs.
window size 480 320 title "tunnel"

draw [
  clear
  look = { sin (time * 0.4) * 0.25 + (mouse.x / width - 0.5) * 0.5, cos (time * 0.3) * 0.12 + (mouse.y / height - 0.5) * 0.3 }
  effect "tunnel.hlsl" by { look: look, glow: 1.8 }
  effect "lens.hlsl" by { strength: 1 }
]
