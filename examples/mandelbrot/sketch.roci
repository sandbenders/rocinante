// Mandelbrot, after Processing's Topics/Fractals and L-Systems/Mandelbrot: every point of
// the window is a number c, and the point is colored by how many times z = z * z + c can be
// worked out before z runs away from the origin. Points that never do are inside the set
// and left dark. The picture is made once, a pixel for each point, from a list of colors,
// and drawn big, so the loop is only run at the start.
window size 480 360 title "mandelbrot" resizable false

WIDE = 160
HIGH = 120
LIMIT = 40

// How many steps it takes z to leave a circle of radius 2, or LIMIT when it does not.
learn escape cx cy [
  zx = 0
  zy = 0
  n = 0
  while n < LIMIT and zx * zx + zy * zy < 4 [
    next = zx * zx - zy * zy + cx
    zy = 2 * zx * zy + cy
    zx = next
    n = n + 1
  ]
  give n
]

colors = []
for py from 0 to HIGH - 1 [
  for px from 0 to WIDE - 1 [
    steps = escape (map px 0 WIDE -2.2 0.8) (map py 0 HIGH -1.125 1.125)
    if steps is LIMIT [
      add (rgb 8 8 20) to colors
    ] else [
      add (hsb (steps * 9 % 256) 200 (90 + steps * 4)) to colors
    ]
  ]
]
fractal = picture from colors size WIDE HIGH

draw [
  background 0
  image fractal at 0 0 width 480
]
